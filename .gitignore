# =======================================================================
# Python 標準の一時ファイル・キャッシュ
# =======================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =======================================================================
# 仮想環境（ローカル開発環境）
# =======================================================================
# 個人開発でよく使われる .venv などを除外
.venv/
venv/
ENV/
env/

# =======================================================================
# テスト・カバレッジ関連（今回の自動化で生成されるゴミファイル）
# =======================================================================
# pytest のキャッシュ
.pytest_cache/

# カバレッジツールの出力とレポートフォルダ
.coverage
.coverage.*
.htmlcov/
htmlcov/
toml-test-report.xml
junit/
coverage.xml

# pytest-html のレポート（必要に応じてローカルで確認するもの）
report.html
assets/

# =======================================================================
# Streamlit 特有の設定・キャッシュ
# =======================================================================
# ローカル検証時の資格情報や設定（ポート番号など）をGit管理から除外
.streamlit/config.toml
.streamlit/secrets.toml

# =======================================================================
# OS・エディタ固有のファイル（Mac / Windows / VS Code）
# =======================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.vscode/
.idea/
